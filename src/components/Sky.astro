---
/**
 * The sky — a fixed, full-page starfield.
 *
 * Stars live in a shallow 3D field: they drift toward the camera, parallax
 * against the pointer and slide with the scroll, so the page feels like it is
 * moving through them. A slow aura of light sits behind.
 */
---

<canvas id="sky" aria-hidden="true"></canvas>
<div class="aura" aria-hidden="true"></div>

<script>
  (() => {
    const sky = document.getElementById('sky');
    if (!(sky instanceof HTMLCanvasElement)) return;
    const ctx = sky.getContext('2d');
    if (!ctx) return;

    const reduce = window.matchMedia('(prefers-reduced-motion: reduce)').matches;

    let W = 0;
    let H = 0;
    let D = 1;
    let seed = 7;
    const rnd = () => (seed = (seed * 16807) % 2147483647) / 2147483647;

    type Star = { x: number; y: number; z: number; ph: number; k: number };
    let stars: Star[] = [];

    const palette = () => {
      const s = getComputedStyle(document.documentElement);
      return {
        gold: s.getPropertyValue('--petal').trim() || '#f6b93b',
        ink: s.getPropertyValue('--text').trim() || '#f4f1ea',
        leaf: s.getPropertyValue('--leaf').trim() || '#5f8f43',
      };
    };
    let col = palette();

    const fit = () => {
      D = Math.min(window.devicePixelRatio || 1, 2);
      W = window.innerWidth;
      H = window.innerHeight;
      sky.width = Math.floor(W * D);
      sky.height = Math.floor(H * D);
      ctx.setTransform(D, 0, 0, D, 0, 0);

      const count = W < 600 ? 110 : W < 1100 ? 190 : 260;
      stars = Array.from({ length: count }, () => ({
        x: rnd() * 2 - 1,
        y: rnd() * 2 - 1,
        z: 0.15 + rnd() * 0.85,
        ph: rnd() * Math.PI * 2,
        k: rnd(),
      }));

      col = palette();
      if (reduce) draw(0);
    };

    let px = 0;
    let py = 0;
    let tx = 0;
    let ty = 0;
    let last = 0;

    const draw = (t: number) => {
      const dt = last ? Math.min(t - last, 50) : 16;
      last = t;

      px += (tx - px) * 0.05;
      py += (ty - py) * 0.05;

      ctx.clearRect(0, 0, W, H);
      const focal = (W + H) * 0.11;
      const scroll = window.scrollY * 0.0006;

      for (const s of stars) {
        if (!reduce) s.z -= dt * 0.000045;
        if (s.z < 0.06) {
          s.z = 1;
          s.x = rnd() * 2 - 1;
          s.y = rnd() * 2 - 1;
        }

        const X = W / 2 + ((s.x - px * 0.16) / s.z) * focal;
        const Y = H / 2 + ((s.y - py * 0.16 - scroll) / s.z) * focal;
        if (X < -30 || X > W + 30 || Y < -30 || Y > H + 30) continue;

        const depth = 1 - s.z;
        const twinkle = reduce ? 1 : 0.55 + 0.45 * Math.sin(t * 0.0015 + s.ph);
        const alpha = Math.min(1, s.z * 6) * Math.min(1, depth * 1.9) * twinkle * 0.9;

        ctx.fillStyle = s.k < 0.14 ? col.gold : s.k < 0.24 ? col.leaf : col.ink;
        ctx.globalAlpha = alpha * (s.k < 0.24 ? 0.75 : 0.85);

        ctx.beginPath();
        ctx.arc(X, Y, 0.5 + 2.1 * depth * depth, 0, Math.PI * 2);
        ctx.fill();
      }
      ctx.globalAlpha = 1;
    };

    const loop = (t: number) => {
      requestAnimationFrame(loop);
      if (document.hidden) return;
      draw(t);
    };

    window.addEventListener(
      'pointermove',
      (e) => {
        tx = (e.clientX / window.innerWidth) * 2 - 1;
        ty = (e.clientY / window.innerHeight) * 2 - 1;
      },
      { passive: true },
    );

    window.addEventListener('resize', fit);
    fit();
    if (!reduce) requestAnimationFrame(loop);

    new MutationObserver(() => {
      col = palette();
      if (reduce) draw(0);
    }).observe(document.documentElement, { attributes: true, attributeFilter: ['data-theme'] });
  })();
</script>

<style>
  #sky {
    position: fixed;
    inset: 0;
    width: 100%;
    height: 100%;
    z-index: -2;
    pointer-events: none;
  }

  .aura {
    position: fixed;
    inset: -20%;
    z-index: -3;
    pointer-events: none;
    background:
      radial-gradient(38% 34% at 22% 26%, rgba(246, 185, 59, 0.1), transparent 70%),
      radial-gradient(34% 38% at 78% 72%, rgba(95, 143, 67, 0.09), transparent 70%);
    animation: aura 26s ease-in-out infinite alternate;
  }

  @keyframes aura {
    to {
      transform: translate3d(6%, -4%, 0) rotate(9deg) scale(1.14);
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .aura { animation: none; }
  }
</style>
