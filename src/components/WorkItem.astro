---
interface Link {
  label: string;
  href: string;
}

interface Props {
  title: string;
  summary: string;
  stack?: string[];
  status?: string;
  year?: string;
  links?: Link[];
}

const { title, summary, stack = [], status = 'active', year, links = [] } = Astro.props;
---

<li>
  <div class="work-head">
    <span class="work-title">{title}</span>
    <span class={`status ${status}`}>[{status}]</span>
    {year && <span class="post-date">{year}</span>}
  </div>
  <p class="work-summary">{summary}</p>
  {stack.length > 0 && (
    <div class="work-meta">
      <span class="work-stack">{stack.join(' · ')}</span>
    </div>
  )}
  {links.length > 0 && (
    <div class="work-links">
      {links.map((l) => (
        <a href={l.href}>{l.label} ↗</a>
      ))}
    </div>
  )}
</li>
