---
import { SITE } from '../site.config';

const path = Astro.url.pathname;
const nav = [
  { href: '/', label: 'home' },
  { href: '/blog', label: 'blog' },
  { href: '/about', label: 'about' },
  { href: '/contact', label: 'contact' },
];

const isCurrent = (href: string) =>
  href === '/' ? path === '/' : path === href || path.startsWith(href + '/');
---

<header class="site-header">
  <div class="header-inner">
    <div class="brand">
      <a class="wordmark" href="/">{SITE.wordmark}</a>
      <span class="tagline">{SITE.tagline}</span>
    </div>

    <nav class="nav" aria-label="primary">
      {nav.map((item) => (
        <a href={item.href} aria-current={isCurrent(item.href) ? 'page' : undefined}>
          [{item.label}]
        </a>
      ))}
    </nav>

    <button
      class="menu-btn"
      type="button"
      aria-label="open menu"
      aria-expanded="false"
      aria-controls="site-menu"
    >
      <span class="menu-bars" aria-hidden="true"><i></i><i></i><i></i></span>
    </button>
  </div>

  <!-- iPhone-style sheet: phones + tablets only. Lives outside .header-inner so the
       glass backdrop-filter there does not become its containing block. -->
  <nav class="menu-panel" id="site-menu" aria-label="mobile">
    <span class="menu-eyebrow">menu</span>
    {nav.map((item) => (
      <a href={item.href} aria-current={isCurrent(item.href) ? 'page' : undefined}>
        {item.label}
      </a>
    ))}
    <span class="menu-foot">{SITE.location}</span>
  </nav>
</header>

<script>
  (() => {
    const btn = document.querySelector('.menu-btn');
    const panel = document.getElementById('site-menu');
    if (!(btn instanceof HTMLElement) || !(panel instanceof HTMLElement)) return;

    const setOpen = (open: boolean) => {
      document.body.classList.toggle('menu-open', open);
      btn.setAttribute('aria-expanded', String(open));
      btn.setAttribute('aria-label', open ? 'close menu' : 'open menu');
    };
    const isOpen = () => document.body.classList.contains('menu-open');

    btn.addEventListener('click', () => setOpen(!isOpen()));

    // tapping a link closes the sheet
    panel.addEventListener('click', (e) => {
      const t = e.target;
      if (t instanceof Element && t.closest('a')) setOpen(false);
    });

    document.addEventListener('keydown', (e) => {
      if (e.key === 'Escape' && isOpen()) setOpen(false);
    });

    // if the viewport grows past the breakpoint, drop back to the inline nav
    const wide = window.matchMedia('(min-width: 901px)');
    if (wide.addEventListener) {
      wide.addEventListener('change', (e) => {
        if (e.matches) setOpen(false);
      });
    }

    // the sheet must clear the floating header, whose height changes with width —
    // publish its bottom edge as --menu-top and let the CSS pad against it
    const header = document.querySelector('.site-header');
    const sync = () => {
      if (!header) return;
      document.documentElement.style.setProperty(
        '--menu-top',
        Math.round(header.getBoundingClientRect().bottom) + 'px',
      );
    };
    sync();
    window.addEventListener('resize', sync);
    window.addEventListener('load', sync);
  })();
</script>
