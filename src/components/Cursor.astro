---
/**
 * Custom cursor — a green pixel dot with a lagging square ring.
 * Only active on fine pointers (mouse/trackpad); untouched on touch devices.
 */
---

<div class="cursor-dot" aria-hidden="true"></div>
<div class="cursor-ring" aria-hidden="true"></div>

<script>
  (() => {
    // Visibility is decided in CSS (@media pointer: fine); the listeners below
    // are cheap enough to attach on any device, and keeping the gate in CSS
    // means the behaviour is testable.
    const dot = document.querySelector('.cursor-dot');
    const ring = document.querySelector('.cursor-ring');
    if (!(dot instanceof HTMLElement) || !(ring instanceof HTMLElement)) return;

    const reduce = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
    let mx = window.innerWidth / 2;
    let my = window.innerHeight / 2;
    let rx = mx;
    let ry = my;
    let shown = false;

    const place = (el, x, y) => {
      el.style.transform = `translate3d(${x}px, ${y}px, 0) translate(-50%, -50%)`;
    };

    window.addEventListener(
      'pointermove',
      (e) => {
        mx = e.clientX;
        my = e.clientY;
        if (!shown) {
          dot.style.opacity = '1';
          ring.style.opacity = '1';
          shown = true;
        }
        place(dot, mx, my);
        if (reduce) place(ring, mx, my);
      },
      { passive: true },
    );

    document.addEventListener('pointerover', (e) => {
      const t = e.target;
      const hot = t instanceof Element && t.closest('a, button, input, textarea, select, .hub-card');
      document.body.classList.toggle('cursor-hot', !!hot);
    });

    window.addEventListener('pointerdown', () => document.body.classList.add('cursor-down'));
    window.addEventListener('pointerup', () => document.body.classList.remove('cursor-down'));
    document.addEventListener('pointerleave', () => {
      dot.style.opacity = '0';
      ring.style.opacity = '0';
      shown = false;
    });

    if (!reduce) {
      (function follow() {
        rx += (mx - rx) * 0.18;
        ry += (my - ry) * 0.18;
        place(ring, rx, ry);
        requestAnimationFrame(follow);
      })();
    }

    // ---- portrait-mode focus -------------------------------------------------
    // Content near the pointer stays sharp; everything further away eases out of
    // focus, like a shallow depth of field. Fine pointers only.
    if (!reduce && window.matchMedia('(pointer: fine)').matches) {
      const MAX = 1.6; // px of blur at the far edge — a haze, not a blackout
      const INNER = 110; // fully sharp within this distance of the block
      const OUTER = 520; // fully blurred beyond this distance
      const SEL = 'p, h1, h2, h3, h4, li, dt, dd, blockquote, figcaption, .hub-card';
      const items = [];

      // Cache rects in *document* space once, so scrolling needs no recompute.
      function collect() {
        items.length = 0;
        document.querySelectorAll(SEL).forEach((el) => {
          if (el.closest('header, footer, nav, .site-header, .site-footer')) return;
          if (!el.textContent || !el.textContent.trim()) return;
          const r = el.getBoundingClientRect();
          if (r.width < 2 || r.height < 2) return;
          items.push({
            el,
            left: r.left + window.scrollX,
            top: r.top + window.scrollY,
            right: r.right + window.scrollX,
            bottom: r.bottom + window.scrollY,
            b: -1,
          });
        });
      }

      let px = -1e6;
      let py = -1e6;
      let queued = false;

      function paint() {
        queued = false;
        for (const it of items) {
          const dx = Math.max(it.left - px, 0, px - it.right);
          const dy = Math.max(it.top - py, 0, py - it.bottom);
          const d = Math.sqrt(dx * dx + dy * dy);
          const t = Math.min(1, Math.max(0, (d - INNER) / (OUTER - INNER)));
          const b = Math.round(t * MAX * 4) / 4;
          if (b !== it.b) {
            it.b = b;
            it.el.style.filter = b > 0.05 ? 'blur(' + b + 'px)' : '';
          }
        }
      }

      const clear = () => {
        px = py = -1e6;
        items.forEach((it) => {
          if (it.b !== 0) {
            it.b = 0;
            it.el.style.filter = '';
          }
        });
      };

      window.addEventListener(
        'pointermove',
        (e) => {
          px = e.clientX + window.scrollX;
          py = e.clientY + window.scrollY;
          if (!queued) {
            queued = true;
            requestAnimationFrame(paint);
          }
        },
        { passive: true },
      );

      document.addEventListener('pointerleave', clear);
      collect();
      window.addEventListener('resize', collect);
      window.addEventListener('load', collect);
      setTimeout(collect, 900);
    }
  })();
</script>
