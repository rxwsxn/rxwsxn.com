---
import { getCollection } from 'astro:content';
import Base from '../../layouts/Base.astro';
import { SITE } from '../../site.config';

const posts = (await getCollection('blog', ({ data }) => !data.draft)).sort(
  (a, b) => b.data.date.valueOf() - a.data.date.valueOf(),
);

const blogUrl = new URL('/blog/', Astro.site).href;

const jsonLd = [
  {
    '@context': 'https://schema.org',
    '@type': 'Blog',
    '@id': `${blogUrl}#blog`,
    url: blogUrl,
    name: 'blog',
    description: 'Dated notes — mostly ai, product, and building.',
    inLanguage: 'en',
    author: { '@type': 'Person', '@id': `${SITE.url}/#person`, name: SITE.name },
    blogPost: posts.map((p) => ({
      '@type': 'BlogPosting',
      headline: p.data.title,
      url: new URL(`/blog/${p.id}/`, Astro.site).href,
      datePublished: p.data.date.toISOString(),
      description: p.data.summary ?? p.data.title,
    })),
  },
];
---

<Base
  title="blog"
  description="Dated notes — mostly ai, product, and building."
  image="/og/blog.png"
  jsonLd={jsonLd}
>
  <div class="page-head wrap">
    <h1>blog</h1>
    <p class="sub">dated notes. mostly ai, product, and building.</p>
  </div>

  <section class="section wrap">
    {posts.length === 0 ? (
      <p class="empty">no posts yet — the first one is on its way.</p>
    ) : (
      <ul class="list">
        {posts.map((post) => (
          <li>
            <div class="post-meta">
              <a class="post-title" href={`/blog/${post.id}/`}>{post.data.title}</a>
              <span class="post-date">{post.data.date.toISOString().slice(0, 10)}</span>
            </div>
            {post.data.summary && <p class="post-excerpt">{post.data.summary}</p>}
            {post.data.tags.length > 0 && (
              <div class="post-tags">
                {post.data.tags.map((t) => (
                  <span>#{t}</span>
                ))}
              </div>
            )}
          </li>
        ))}
      </ul>
    )}
  </section>
</Base>
