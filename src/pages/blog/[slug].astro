---
import fs from 'node:fs';
import { getCollection, render } from 'astro:content';
import Base from '../../layouts/Base.astro';
import { SITE } from '../../site.config';

export async function getStaticPaths() {
  const posts = await getCollection('blog', ({ data }) => !data.draft);
  return posts.map((post) => ({ params: { slug: post.id }, props: { post } }));
}

const { post } = Astro.props;
const { Content } = await render(post);

const iso = post.data.date.toISOString();
const date = iso.slice(0, 10);
const url = new URL(`/blog/${post.id}/`, Astro.site).href;

// Use a per-post social card if the generator produced one; fall back to the site card.
const perPost = `/og/${post.id}.png`;
const image = fs.existsSync(`public${perPost}`) ? perPost : '/og.png';

const jsonLd = [
  {
    '@context': 'https://schema.org',
    '@type': 'BlogPosting',
    '@id': `${url}#article`,
    headline: post.data.title,
    description: post.data.summary ?? post.data.title,
    datePublished: iso,
    dateModified: iso,
    inLanguage: 'en',
    mainEntityOfPage: url,
    image: new URL(image, Astro.site).href,
    keywords: post.data.tags.join(', '),
    author: { '@type': 'Person', '@id': `${SITE.url}/#person`, name: SITE.name, url: SITE.url },
    publisher: { '@type': 'Person', '@id': `${SITE.url}/#person`, name: SITE.name },
  },
  {
    '@context': 'https://schema.org',
    '@type': 'BreadcrumbList',
    itemListElement: [
      { '@type': 'ListItem', position: 1, name: 'home', item: SITE.url },
      { '@type': 'ListItem', position: 2, name: 'blog', item: new URL('/blog/', Astro.site).href },
      { '@type': 'ListItem', position: 3, name: post.data.title, item: url },
    ],
  },
];
---

<Base
  title={post.data.title}
  description={post.data.summary ?? post.data.title}
  image={image}
  imageAlt={post.data.title}
  article
  publishedTime={iso}
  modifiedTime={iso}
  tags={post.data.tags}
  jsonLd={jsonLd}
>
  <article class="wrap">
    <div class="post-head">
      <a class="back" href="/blog">← blog</a>
      <h1>{post.data.title}</h1>
      <div class="post-meta">
        <span class="post-date">{date}</span>
        {post.data.tags.map((t) => (
          <span class="muted2">#{t}</span>
        ))}
      </div>
    </div>

    <div class="prose">
      <Content />
    </div>

    <div class="post-foot">
      <a class="back" href="/blog">← all posts</a>
    </div>
  </article>
</Base>
