---
import { getCollection } from 'astro:content';
import Base from '../layouts/Base.astro';
import WorkItem from '../components/WorkItem.astro';

const items = (await getCollection('work')).sort((a, b) => a.data.order - b.data.order);

const groups = new Map<string, typeof items>();
for (const item of items) {
  const g = item.data.group;
  if (!groups.has(g)) groups.set(g, []);
  groups.get(g)!.push(item);
}
const groupNames = [...groups.keys()];
---

<Base title="work" description="Things I've built, am building, and plan to build.">
  <div class="page-head wrap">
    <h1>work</h1>
    <p class="sub">things i've built, am building, and plan to build. text first, links out.</p>
  </div>

  <section class="section wrap">
    {items.length === 0 ? (
      <p class="empty">nothing here yet — add markdown files to src/content/work.</p>
    ) : (
      groupNames.map((name) => (
        <div class="work-group">
          <span class="label">{name}</span>
          <ul class="list">
            {groups.get(name)!.map((item) => (
              <WorkItem
                title={item.data.title}
                summary={item.data.summary}
                stack={item.data.stack}
                status={item.data.status}
                year={item.data.year}
                links={item.data.links}
              />
            ))}
          </ul>
        </div>
      ))
    )}
  </section>
</Base>
