---
import { getCollection } from 'astro:content';
import Base from '../layouts/Base.astro';
import { SITE } from '../site.config';

const work = (await getCollection('work')).sort((a, b) => a.data.order - b.data.order);
const pad = (n: number) => String(n).padStart(2, '0');

const jsonLd = [
  {
    '@context': 'https://schema.org',
    '@type': 'CollectionPage',
    url: new URL('/work/', Astro.site).href,
    name: 'work',
    inLanguage: 'en',
    author: { '@type': 'Person', '@id': `${SITE.url}/#person`, name: SITE.name },
  },
];
---

<Base title="work" description={`Selected work — ${SITE.name}.`} image="/og.png" jsonLd={jsonLd}>
  <div class="page-head wrap">
    <span class="micro">Selected work</span>
    <h1>work</h1>
    <p class="sub">Things built and shipped, mostly in production.</p>
  </div>

  <section class="section wrap">
    {
      work.length > 0 ? (
        <ul class="list">
          {work.map((item, i) => (
            <li class="reveal">
              <span class="idx">{pad(i + 1)}</span>
              <div class="row-main">
                <span class="work-title">{item.data.title}</span>
                <p class="work-summary">{item.data.summary}</p>
                <div class="work-meta">
                  {item.data.org && <span>{item.data.org}</span>}
                  {item.data.stack.length > 0 && <span>{item.data.stack.join(' · ')}</span>}
                </div>
                {item.data.links.length > 0 && (
                  <div class="work-links">
                    {item.data.links.map((l) => (
                      <a href={l.href} target="_blank" rel="noopener">
                        {l.label} ↗
                      </a>
                    ))}
                  </div>
                )}
              </div>
              <span class="post-date">{item.data.period}</span>
            </li>
          ))}
        </ul>
      ) : (
        <p class="empty">Nothing here yet.</p>
      )
    }
  </section>
</Base>
