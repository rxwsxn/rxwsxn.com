---
import Base from '../layouts/Base.astro';

/**
 * Authoring studio — unlisted, noindex, never linked from the site.
 *
 * Writes a post without a backend: slug, frontmatter, reading time, canonical
 * URL and a 1200x630 social card are all generated in the browser. Drafts live
 * in localStorage; the export is the .md file you drop into
 * src/content/blog/ and commit.
 */
---

<Base title="studio" description="Authoring studio." noindex bare>
  <div class="st">
    <header class="st-bar">
      <div class="st-brand">
        <span class="wordmark">studio</span>
        <span class="micro">writing · drafts · social cards</span>
      </div>
      <div class="st-actions">
        <button class="btn" id="save" type="button">Save locally</button>
        <button class="btn" id="download" type="button">Download .md</button>
        <button class="btn btn--go" id="publish" type="button">Publish</button>
      </div>
    </header>

    <div class="st-grid">
      <!-- ---------------------------------------------------------- editor -->
      <section class="st-pane">
        <label class="fld">
          <span class="micro">Title</span>
          <input id="title" type="text" placeholder="What the piece is about" autocomplete="off" />
        </label>

        <div class="row2">
          <label class="fld">
            <span class="micro">Slug</span>
            <span class="slug-wrap">
              <input id="slug" type="text" placeholder="auto-from-title" autocomplete="off" />
              <button class="mini" id="reslug" type="button" title="Rebuild from title">↻</button>
            </span>
          </label>

          <label class="fld">
            <span class="micro">Date</span>
            <input id="date" type="date" />
          </label>
        </div>

        <label class="fld">
          <span class="micro">Summary <em id="sumcount">0</em></span>
          <textarea id="summary" rows="2" placeholder="One line for the index and the card."></textarea>
        </label>

        <label class="fld">
          <span class="micro">Tags</span>
          <input id="tags" type="text" placeholder="ai, product, building" autocomplete="off" />
        </label>

        <label class="fld fld--grow">
          <span class="micro">
            Body — markdown
            <button class="mini" id="add-image" type="button" style="float:right">+ image</button>
          </span>
          <input id="file" type="file" accept="image/png,image/jpeg,image/webp,image/gif,image/avif" hidden />
          <textarea id="body" class="body" placeholder="# heading&#10;&#10;Write here. **bold**, *italic*, `code`, [links](https://example.com), - lists"></textarea>
        </label>

        <div class="st-foot">
          <label class="chk">
            <input id="draft" type="checkbox" checked />
            <span>Draft (hidden from the site)</span>
          </label>
          <span class="micro" id="stats">0 words · 0 min</span>
        </div>
      </section>

      <!-- --------------------------------------------------------- preview -->
      <section class="st-pane st-pane--right">
        <div class="prev-head">
          <span class="micro">Preview</span>
          <span class="micro" id="url">/blog/…</span>
        </div>

        <article class="prev-article">
          <h1 id="pv-title">Untitled</h1>
          <p class="prev-meta" id="pv-meta">—</p>
          <div class="prev-body" id="pv-body"></div>
        </article>

        <div class="prev-head">
          <span class="micro">Social card · 1200 × 630</span>
          <button class="mini" id="card-refresh" type="button">Redraw</button>
        </div>
        <canvas id="card" width="1200" height="630" class="card"></canvas>

        <div class="prev-head">
          <span class="micro">Output</span>
          <span class="st-actions">
            <button class="mini" id="copy" type="button">Copy .md</button>
            <button class="mini" id="copycard" type="button">Download card</button>
          </span>
        </div>
        <pre class="out" id="out"></pre>

        <div class="prev-head">
          <span class="micro">Live · repository</span>
          <span class="micro" id="live-status">not connected</span>
        </div>

        <div class="live">
          <label class="fld">
            <span class="micro">Studio token</span>
            <span class="slug-wrap">
              <input id="token" type="password" placeholder="STUDIO_TOKEN" autocomplete="off" />
              <button class="mini" id="token-save" type="button">Use</button>
            </span>
          </label>

          <div class="st-actions">
            <button class="mini" id="check" type="button">Check connection</button>
            <button class="mini" id="repo-refresh" type="button">Load from repo</button>
            <button class="mini" id="publish-2" type="button">Publish now</button>
          </div>

          <div id="result-slot"></div>

          <p class="hint" id="live-hint">
            Publishing needs <code>STUDIO_TOKEN</code>, <code>GITHUB_TOKEN</code> and
            <code>GITHUB_REPO</code> in the Pages project, and the Functions deployed.
            Until then everything below still works locally.
          </p>

          <ul class="drafts" id="repo-list"></ul>
        </div>

        <div class="prev-head">
          <span class="micro">Local drafts <em id="autosave">—</em></span>
        </div>
        <ul class="drafts" id="drafts"></ul>

        <details class="how">
          <summary class="micro">How it ships</summary>
          <ol>
            <li>Download the <code>.md</code> and drop it in <code>src/content/blog/</code>.</li>
            <li>Download the card into <code>public/og/&lt;slug&gt;.png</code> — or run <code>npm run images</code> to generate every card.</li>
            <li>Set <code>draft: false</code> when you're ready, then commit and push.</li>
          </ol>
        </details>
      </section>
    </div>
  </div>
</Base>

<script>
  (() => {
    const $ = <T extends HTMLElement>(id: string) => document.getElementById(id) as T | null;

    const titleEl = $<HTMLInputElement>('title');
    const slugEl = $<HTMLInputElement>('slug');
    const dateEl = $<HTMLInputElement>('date');
    const summaryEl = $<HTMLTextAreaElement>('summary');
    const tagsEl = $<HTMLInputElement>('tags');
    const bodyEl = $<HTMLTextAreaElement>('body');
    const draftEl = $<HTMLInputElement>('draft');
    const outEl = $<HTMLPreElement>('out');
    const pvTitle = $<HTMLElement>('pv-title');
    const pvMeta = $<HTMLElement>('pv-meta');
    const pvBody = $<HTMLElement>('pv-body');
    const statsEl = $<HTMLElement>('stats');
    const urlEl = $<HTMLElement>('url');
    const cardEl = $<HTMLCanvasElement>('card');
    const draftsEl = $<HTMLUListElement>('drafts');

    if (!titleEl || !slugEl || !bodyEl || !outEl || !cardEl) return;

    const KEY = 'rxwsxn-studio-drafts';
    let slugLocked = false;

    /* ---------------------------------------------------------- helpers */

    const slugify = (input: string) =>
      input
        .toLowerCase()
        .normalize('NFKD')
        .replace(/[\u0300-\u036f]/g, '')
        .replace(/['’]/g, '')
        .replace(/[^a-z0-9]+/g, '-')
        .replace(/-+/g, '-')
        .replace(/^-|-$/g, '')
        .slice(0, 64)
        .replace(/-$/, '');

    const today = () => new Date().toISOString().slice(0, 10);

    const tagList = () =>
      tagsEl
        ? tagsEl.value
            .split(',')
            .map((t) => t.trim().replace(/^#/, ''))
            .filter(Boolean)
        : [];

    const words = (s: string) => (s.trim() ? s.trim().split(/\s+/).length : 0);
    const minutes = (n: number) => Math.max(1, Math.round(n / 220));

    const escapeHtml = (s: string) =>
      s.replace(/&/g, '&amp;').replace(/</g, '&lt;').replace(/>/g, '&gt;');

    /** small, safe markdown: escapes first, then formats */
    const md = (src: string) => {
      const lines = escapeHtml(src).split(/\r?\n/);
      const out: string[] = [];
      let inList = false;
      let inCode = false;

      const inline = (t: string) =>
        t
          .replace(/`([^`]+)`/g, '<code>$1</code>')
          .replace(/!\[([^\]]*)\]\(([^)\s]+)\)/g, '<img src="$2" alt="$1" loading="lazy" />')
          .replace(/\*\*([^*]+)\*\*/g, '<strong>$1</strong>')
          .replace(/(^|[^*])\*([^*]+)\*/g, '$1<em>$2</em>')
          .replace(
            /\[([^\]]+)\]\(((?:https?:\/\/|\/|\.\/)[^)\s]+)\)/g,
            (_m, label, href) =>
              `<a href="${href}"${href.startsWith('http') ? ' target="_blank" rel="noopener"' : ''}>${label}</a>`,
          );

      for (const line of lines) {
        if (/^```/.test(line)) {
          if (inCode) {
            out.push('</code></pre>');
            inCode = false;
          } else {
            out.push('<pre><code>');
            inCode = true;
          }
          continue;
        }
        if (inCode) {
          out.push(line);
          continue;
        }
        const fig = line.match(/^!\[([^\]]*)\]\(([^)\s]+)\)\s*$/);
        if (fig) {
          if (inList) { out.push('</ul>'); inList = false; }
          out.push(`<figure><img src="${fig[2]}" alt="${fig[1]}" loading="lazy" /></figure>`);
          continue;
        }

        const h = line.match(/^(#{1,3})\s+(.*)$/);
        if (h) {
          if (inList) { out.push('</ul>'); inList = false; }
          const level = h[1].length + 1;
          out.push(`<h${level}>${inline(h[2])}</h${level}>`);
          continue;
        }
        const li = line.match(/^\s*[-*]\s+(.*)$/);
        if (li) {
          if (!inList) { out.push('<ul>'); inList = true; }
          out.push(`<li>${inline(li[1])}</li>`);
          continue;
        }
        if (inList) { out.push('</ul>'); inList = false; }
        if (!line.trim()) { out.push(''); continue; }
        out.push(`<p>${inline(line)}</p>`);
      }
      if (inList) out.push('</ul>');
      if (inCode) out.push('</code></pre>');
      return out.join('\n');
    };

    const frontmatter = () => {
      const tags = tagList();
      const summary = (summaryEl?.value || '').trim();
      return [
        '---',
        `title: ${JSON.stringify(titleEl.value.trim() || 'untitled')}`,
        `date: ${dateEl?.value || today()}`,
        summary ? `summary: ${JSON.stringify(summary)}` : 'summary: ""',
        `tags: [${tags.join(', ')}]`,
        `draft: ${draftEl?.checked ? 'true' : 'false'}`,
        '---',
        '',
        bodyEl.value.trim(),
        '',
      ].join('\n');
    };

    /* ---------------------------------------------------------- render */

    const render = () => {
      if (!slugLocked) slugEl.value = slugify(titleEl.value);
      const slug = slugEl.value || 'untitled';
      const w = words(bodyEl.value);

      if (statsEl) statsEl.textContent = `${w} words · ${minutes(w)} min`;
      if (urlEl) urlEl.textContent = `/blog/${slug}/`;
      const sc = document.getElementById('sumcount');
      if (sc) sc.textContent = String((summaryEl?.value || '').length);

      if (pvTitle) pvTitle.textContent = titleEl.value.trim() || 'Untitled';
      if (pvMeta)
        pvMeta.textContent = `${dateEl?.value || today()} · ${minutes(w)} min read`;
      if (pvBody) pvBody.innerHTML = md(bodyEl.value);

      outEl.textContent = frontmatter();
      drawCard();
    };

    /* ---------------------------------------------------------- card */

    const wrapText = (
      ctx: CanvasRenderingContext2D,
      text: string,
      maxWidth: number,
      maxLines: number,
    ) => {
      const wordsArr = text.split(/\s+/);
      const lines: string[] = [];
      let line = '';
      for (const word of wordsArr) {
        const test = line ? `${line} ${word}` : word;
        if (ctx.measureText(test).width > maxWidth && line) {
          lines.push(line);
          line = word;
          if (lines.length === maxLines) break;
        } else {
          line = test;
        }
      }
      if (lines.length < maxLines && line) lines.push(line);
      if (lines.length === maxLines) {
        const last = lines[maxLines - 1];
        if (ctx.measureText(last).width > maxWidth - 40) {
          lines[maxLines - 1] = last.replace(/[\s,.;:—-]*\S*$/, '') + '…';
        }
      }
      return lines;
    };

    const drawCard = () => {
      const ctx = cardEl.getContext('2d');
      if (!ctx) return;

      const W = cardEl.width;
      const H = cardEl.height;
      const light = document.documentElement.dataset.theme === 'light';

      const bg = light ? '#f2efe9' : '#0b0b0b';
      const ink = light ? '#121212' : '#f4f1ea';
      const dim = light ? '#55554f' : '#8b8b86';
      const gold = light ? '#8a5a00' : '#f6b93b';

      ctx.fillStyle = bg;
      ctx.fillRect(0, 0, W, H);

      ctx.strokeStyle = light ? 'rgba(18,18,18,.18)' : 'rgba(244,241,234,.18)';
      ctx.lineWidth = 2;
      ctx.strokeRect(24, 24, W - 48, H - 48);

      ctx.textBaseline = 'alphabetic';
      ctx.fillStyle = dim;
      ctx.font = '500 22px Archivo, sans-serif';
      ctx.fillText('rxwsxn.com / writing', 64, 100);

      ctx.textAlign = 'right';
      ctx.fillText(dateEl?.value || today(), W - 64, 100);
      ctx.textAlign = 'left';

      const title = titleEl.value.trim() || 'Untitled';
      let size = 76;
      let lines: string[] = [];
      do {
        ctx.font = `800 ${size}px Archivo, sans-serif`;
        lines = wrapText(ctx, title, W - 128, 3);
        if (lines.length <= 3 && ctx.measureText(lines[0] || '').width <= W - 128) break;
        size -= 6;
      } while (size > 40);

      ctx.fillStyle = ink;
      lines.forEach((line, i) => {
        ctx.fillText(line, 64, 240 + i * size * 1.02);
      });

      const ruleY = 240 + lines.length * size * 1.02 + 10;
      ctx.strokeStyle = gold;
      ctx.lineWidth = 4;
      ctx.beginPath();
      ctx.moveTo(64, ruleY);
      ctx.lineTo(64 + 120, ruleY);
      ctx.stroke();

      const summary = (summaryEl?.value || '').trim();
      if (summary) {
        ctx.fillStyle = dim;
        ctx.font = '400 26px Archivo, sans-serif';
        wrapText(ctx, summary, W - 128, 2).forEach((line, i) => {
          ctx.fillText(line, 64, ruleY + 52 + i * 36);
        });
      }

      const tags = tagList();
      if (tags.length) {
        ctx.fillStyle = gold;
        ctx.font = '500 20px Archivo, sans-serif';
        ctx.fillText(tags.map((t) => `#${t}`).join('   '), 64, H - 74);
      }

      ctx.fillStyle = dim;
      ctx.font = '500 20px Archivo, sans-serif';
      ctx.textAlign = 'right';
      ctx.fillText('raushan kumar', W - 64, H - 74);
      ctx.textAlign = 'left';
    };

    /* ---------------------------------------------------------- drafts */

    const readDrafts = (): Record<string, Record<string, unknown>> => {
      try {
        return JSON.parse(localStorage.getItem(KEY) || '{}');
      } catch {
        return {};
      }
    };

    const writeDrafts = (d: Record<string, unknown>) => {
      try {
        localStorage.setItem(KEY, JSON.stringify(d));
      } catch {
        /* private mode */
      }
    };

    const snapshot = () => ({
      title: titleEl.value,
      slug: slugEl.value,
      date: dateEl?.value || today(),
      summary: summaryEl?.value || '',
      tags: tagsEl?.value || '',
      body: bodyEl.value,
      draft: draftEl?.checked ?? true,
      saved: Date.now(),
    });

    const fill = (d: Record<string, any>) => {
      titleEl.value = d.title || '';
      slugEl.value = d.slug || '';
      if (dateEl) dateEl.value = d.date || today();
      if (summaryEl) summaryEl.value = d.summary || '';
      if (tagsEl) tagsEl.value = d.tags || '';
      bodyEl.value = d.body || '';
      if (draftEl) draftEl.checked = d.draft ?? true;
      slugLocked = true;
      render();
    };

    const paintDrafts = () => {
      if (!draftsEl) return;
      const all = readDrafts();
      const keys = Object.keys(all).sort((a, b) => (all[b].saved as number) - (all[a].saved as number));
      draftsEl.innerHTML = '';

      if (!keys.length) {
        const li = document.createElement('li');
        li.className = 'empty';
        li.textContent = 'No saved drafts yet.';
        draftsEl.appendChild(li);
        return;
      }

      keys.forEach((k) => {
        const d = all[k];
        const li = document.createElement('li');

        const open = document.createElement('button');
        open.type = 'button';
        open.className = 'draft-open';
        open.innerHTML = `<strong></strong><span></span>`;
        (open.querySelector('strong') as HTMLElement).textContent = String(d.title || k);
        (open.querySelector('span') as HTMLElement).textContent =
          `${d.draft ? 'draft' : 'published'} · ${String(d.slug || k)}`;
        open.addEventListener('click', () => fill(d as Record<string, any>));

        const del = document.createElement('button');
        del.type = 'button';
        del.className = 'mini';
        del.textContent = '×';
        del.title = 'Delete draft';
        del.addEventListener('click', () => {
          const next = readDrafts();
          delete next[k];
          writeDrafts(next);
          paintDrafts();
        });

        li.append(open, del);
        draftsEl.appendChild(li);
      });
    };

    /* ---------------------------------------------------------- actions */

    const download = (name: string, blob: Blob) => {
      const a = document.createElement('a');
      a.href = URL.createObjectURL(blob);
      a.download = name;
      a.click();
      setTimeout(() => URL.revokeObjectURL(a.href), 2000);
    };

    /* ------------------------------------------------- live repository */

    const TOKEN_KEY = 'rxwsxn-studio-token';
    const tokenEl = $<HTMLInputElement>('token');
    const statusEl = $<HTMLElement>('live-status');
    const repoList = $<HTMLUListElement>('repo-list');

    let token = '';
    try {
      token = localStorage.getItem(TOKEN_KEY) || '';
    } catch {
      /* private mode */
    }
    if (tokenEl && token) tokenEl.value = token;

    const setStatus = (text: string, bad = false) => {
      if (!statusEl) return;
      statusEl.textContent = text;
      statusEl.style.color = bad ? 'var(--red)' : '';
    };

    /** Turns whatever the edge returns into something actionable. */
    const explain = (status: number, detail: string) => {
      if (status === 404) {
        return 'no /api route — Functions are not deployed yet (or you are on astro dev, which does not run them)';
      }
      if (status === 401) return 'token rejected — check STUDIO_TOKEN';
      if (status === 503) return 'server not configured — add STUDIO_TOKEN, GITHUB_TOKEN and GITHUB_REPO in Pages, then redeploy';
      if (status === 502) return `github refused the write — ${detail}`;
      return detail || `HTTP ${status}`;
    };

    const api = async (path: string, init: RequestInit = {}) => {
      let res: Response;
      try {
        res = await fetch(path, {
          ...init,
          headers: {
            authorization: `Bearer ${token}`,
            'content-type': 'application/json',
            ...(init.headers || {}),
          },
        });
      } catch {
        throw new Error('network — the request never left the browser');
      }

      const text = await res.text();
      let data: any = {};
      try {
        data = text ? JSON.parse(text) : {};
      } catch {
        /* not json — probably an HTML 404 page */
      }

      if (!res.ok) throw new Error(explain(res.status, data.error || text.slice(0, 120)));
      return data;
    };

    const fields = () => ({
      slug: slugEl.value,
      title: titleEl.value.trim(),
      date: dateEl?.value || today(),
      summary: (summaryEl?.value || '').trim(),
      tags: tagList(),
      body: bodyEl.value,
      draft: draftEl?.checked ?? true,
    });

    const publish = async () => {
      if (!token) {
        setStatus('add a token first', true);
        return;
      }
      if (!titleEl.value.trim() || !bodyEl.value.trim()) {
        setStatus('title and body required', true);
        return;
      }

      setStatus('pushing…');
      try {
        const og = cardEl.toDataURL('image/png').split(',')[1];
        const data = await api('/api/publish', {
          method: 'POST',
          body: JSON.stringify({ ...fields(), og }),
        });
        showResult(data.url, data.draft);
        setStatus(`${data.draft ? 'draft pushed' : 'published'} · ${data.commit} · live in ~1 min`, false);
        loadRepo(true);
      } catch (err) {
        setStatus(String((err as Error).message), true);
      }
    };

    const loadRepo = async (silent = false) => {
      if (!token) {
        setStatus('add a token first', true);
        return;
      }
      if (!repoList) return;
      if (!silent) setStatus('loading…');
      try {
        const data = await api('/api/posts');
        const posts = Array.isArray(data.posts) ? data.posts : [];
        if (!silent) setStatus(`${posts.length} in repo`);
        repoList.innerHTML = '';

        if (!posts.length) {
          const li = document.createElement('li');
          li.className = 'empty';
          li.textContent = 'Nothing in the repo yet.';
          repoList.appendChild(li);
          return;
        }

        posts.forEach((p: any) => {
          const li = document.createElement('li');
          const open = document.createElement('button');
          open.type = 'button';
          open.className = 'draft-open';
          open.innerHTML = '<strong></strong><span></span>';
          (open.querySelector('strong') as HTMLElement).textContent = p.title;
          (open.querySelector('span') as HTMLElement).textContent =
            `${p.draft ? 'draft' : 'live'} · ${p.date} · ${p.slug}`;
          open.addEventListener('click', async () => {
            try {
              const one = await api(`/api/posts?slug=${encodeURIComponent(p.slug)}`);
              fill(one.post);
              setStatus(`opened ${p.slug}`);
            } catch (err) {
              setStatus(String((err as Error).message).slice(0, 60), true);
            }
          });
          li.appendChild(open);
          repoList.appendChild(li);
        });
      } catch (err) {
        if (!silent) setStatus(String((err as Error).message).slice(0, 60), true);
      }
    };

    $<HTMLButtonElement>('token-save')?.addEventListener('click', () => {
      token = tokenEl?.value.trim() || '';
      try {
        localStorage.setItem(TOKEN_KEY, token);
      } catch {
        /* private mode */
      }
      setStatus(token ? 'token saved' : 'no token');
      if (token) loadRepo();
    });

    const slot = document.getElementById('result-slot');
    const resultEl = document.createElement('div');
    resultEl.className = 'result';
    resultEl.hidden = true;
    slot?.appendChild(resultEl);

    const showResult = (url: string, draft: boolean) => {
      if (!resultEl) return;
      resultEl.hidden = false;
      resultEl.innerHTML = '';
      const label = document.createElement('span');
      label.className = 'result-label';
      label.textContent = draft ? 'draft saved — flip the toggle to publish it' : 'live at';
      const link = document.createElement('a');
      link.href = url;
      link.textContent = url.replace('https://rxwsxn.com', '');
      link.target = '_blank';
      link.rel = 'noopener';
      const copy = document.createElement('button');
      copy.type = 'button';
      copy.className = 'mini';
      copy.textContent = 'copy link';
      copy.addEventListener('click', async () => {
        try {
          await navigator.clipboard.writeText(url);
          copy.textContent = 'copied';
        } catch {
          copy.textContent = 'copy failed';
        }
        setTimeout(() => (copy.textContent = 'copy link'), 1400);
      });
      resultEl.append(label, link, copy);
    };

    /* ------------------------------------------------- images */

    const fileEl = $<HTMLInputElement>('file');

    const insertAtCursor = (text: string) => {
      const start = bodyEl.selectionStart ?? bodyEl.value.length;
      const end = bodyEl.selectionEnd ?? start;
      const before = bodyEl.value.slice(0, start);
      const after = bodyEl.value.slice(end);
      const pad = before.endsWith('\n') || !before ? '' : '\n\n';
      bodyEl.value = `${before}${pad}${text}\n\n${after}`;
      bodyEl.dispatchEvent(new Event('input', { bubbles: true }));
      bodyEl.focus();
    };

    const uploadImage = async (file: File) => {
      if (!token) {
        setStatus('add a token first', true);
        return;
      }
      if (!file.type.startsWith('image/')) {
        setStatus('not an image', true);
        return;
      }
      if (file.size > 6 * 1024 * 1024) {
        setStatus('image over 6MB — compress it first', true);
        return;
      }

      setStatus(`uploading ${file.name}…`);
      try {
        const data = await new Promise<string>((resolve, reject) => {
          const reader = new FileReader();
          reader.onload = () => resolve(String(reader.result).split(',')[1] || '');
          reader.onerror = () => reject(new Error('could not read the file'));
          reader.readAsDataURL(file);
        });

        const res = await api('/api/upload', {
          method: 'POST',
          body: JSON.stringify({
            slug: slugEl.value || 'misc',
            filename: file.name,
            type: file.type,
            data,
          }),
        });

        insertAtCursor(`![${file.name.replace(/\.[^.]+$/, '')}](${res.url})`);
        setStatus(`image added · ${res.commit}`);
      } catch (err) {
        setStatus(String((err as Error).message), true);
      }
    };

    $<HTMLButtonElement>('add-image')?.addEventListener('click', () => fileEl?.click());
    fileEl?.addEventListener('change', () => {
      const f = fileEl.files && fileEl.files[0];
      if (f) uploadImage(f);
      fileEl.value = '';
    });

    // drop or paste straight into the body
    bodyEl.addEventListener('dragover', (e) => e.preventDefault());
    bodyEl.addEventListener('drop', (e) => {
      const f = e.dataTransfer?.files && e.dataTransfer.files[0];
      if (!f) return;
      e.preventDefault();
      uploadImage(f);
    });
    bodyEl.addEventListener('paste', (e) => {
      const f = e.clipboardData?.files && e.clipboardData.files[0];
      if (!f) return;
      e.preventDefault();
      uploadImage(f);
    });

    $<HTMLButtonElement>('check')?.addEventListener('click', async () => {
      if (!token) {
        setStatus('add a token first', true);
        return;
      }
      setStatus('checking…');
      try {
        const data = await api('/api/posts');
        const n = Array.isArray(data.posts) ? data.posts.length : 0;
        setStatus(`connected · ${n} post${n === 1 ? '' : 's'} in the repo`);
      } catch (err) {
        setStatus(String((err as Error).message), true);
      }
    });

    $<HTMLButtonElement>('repo-refresh')?.addEventListener('click', loadRepo);
    $<HTMLButtonElement>('publish-2')?.addEventListener('click', publish);

    $<HTMLButtonElement>('save')?.addEventListener('click', () => {
      const d = readDrafts();
      const key = slugEl.value || `untitled-${Date.now()}`;
      d[key] = snapshot();
      writeDrafts(d);
      paintDrafts();
    });

    $<HTMLButtonElement>('download')?.addEventListener('click', () => {
      const slug = slugEl.value || 'untitled';
      download(`${slug}.md`, new Blob([frontmatter()], { type: 'text/markdown' }));
    });

    $<HTMLButtonElement>('publish')?.addEventListener('click', publish);

    $<HTMLButtonElement>('copycard')?.addEventListener('click', () => {
      cardEl.toBlob((blob) => {
        if (blob) download(`${slugEl.value || 'untitled'}.png`, blob);
      }, 'image/png');
    });

    $<HTMLButtonElement>('copy')?.addEventListener('click', async (e) => {
      const btn = e.currentTarget as HTMLButtonElement;
      try {
        await navigator.clipboard.writeText(frontmatter());
        btn.textContent = 'Copied';
      } catch {
        btn.textContent = 'Copy failed';
      }
      setTimeout(() => (btn.textContent = 'Copy .md'), 1400);
    });

    $<HTMLButtonElement>('card-refresh')?.addEventListener('click', drawCard);

    $<HTMLButtonElement>('reslug')?.addEventListener('click', () => {
      slugLocked = false;
      slugEl.value = slugify(titleEl.value);
      slugLocked = true;
      render();
    });

    slugEl.addEventListener('input', () => {
      slugLocked = true;
      slugEl.value = slugify(slugEl.value);
      render();
    });

    [titleEl, summaryEl, tagsEl, bodyEl, dateEl, draftEl].forEach((el) => {
      el?.addEventListener('input', render);
      el?.addEventListener('change', render);
    });

    /* ---------------------------------------------------------- boot */

    /* ------------------------------------------------ autosave + shortcuts */

    const AUTOSAVE = 'rxwsxn-studio-autosave';
    const badge = document.getElementById('autosave');
    let saveTimer = 0;

    const autosave = () => {
      try {
        localStorage.setItem(AUTOSAVE, JSON.stringify(snapshot()));
        if (badge) {
          badge.textContent = '· saved ' + new Date().toLocaleTimeString([], { hour: '2-digit', minute: '2-digit' });
        }
      } catch {
        /* private mode */
      }
    };

    const scheduleSave = () => {
      window.clearTimeout(saveTimer);
      saveTimer = window.setTimeout(autosave, 700);
    };

    ['title', 'summary', 'tags', 'body', 'date', 'slug'].forEach((id) => {
      document.getElementById(id)?.addEventListener('input', scheduleSave);
    });

    document.addEventListener('keydown', (e) => {
      const mod = e.metaKey || e.ctrlKey;
      if (!mod) return;
      if (e.key === 's') {
        e.preventDefault();
        autosave();
        setStatus('saved locally');
      }
      if (e.key === 'Enter') {
        e.preventDefault();
        publish();
      }
    });

    /* ------------------------------------------------ boot */

    if (dateEl && !dateEl.value) dateEl.value = today();

    // recover the last autosave before the first paint of the preview
    try {
      const saved = localStorage.getItem(AUTOSAVE);
      if (saved) {
        const d = JSON.parse(saved);
        if (d && (d.title || d.body)) fill(d);
      }
    } catch {
      /* ignore a corrupt autosave */
    }

    paintDrafts();
    render();

    // redraw the card once the webfonts land, so it isn't a fallback face
    if (document.fonts?.ready) document.fonts.ready.then(drawCard);
  })();
</script>

