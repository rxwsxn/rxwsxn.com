---
import Base from '../layouts/Base.astro';
import SocialIcon from '../components/SocialIcon.astro';
import { SITE } from '../site.config';

/**
 * Link in bio. Unlisted: no nav entry, noindex, out of the sitemap.
 * One narrow column, one stack of buttons, nothing else.
 */
const email = SITE.links.find((l) => l.label === 'email');
const mailto = email ? email.href.replace(/^mailto:/, '') : SITE.email;

const KEEP = ['x', 'linkedin', 'instagram', 'youtube'];
const socials = KEEP.map((k) => SITE.links.find((l) => l.label === k)).filter(
  (l): l is { label: string; href: string } => Boolean(l),
);
---

<Base title="links" description={`Everywhere ${SITE.name} is.`} image="/og/links.png" noindex bare>
  <div class="lt">
    <div class="lt-mark" aria-hidden="true">
      <svg viewBox="0 0 24 24">
        {
          Array.from({ length: 9 }).map((_, i) => (
            <ellipse cx="12" cy="5.4" rx="2.1" ry="5" transform={`rotate(${i * 40} 12 12)`} />
          ))
        }
        <circle cx="12" cy="12" r="3.4" />
      </svg>
    </div>

    <h1>{SITE.wordmark}</h1>
    <p class="lt-role">{SITE.jobTitle}</p>

    <nav class="lt-stack" aria-label="Links">
      <a class="lt-link" href={`mailto:${mailto}`}>
        <span>email</span>
        <em>{mailto}</em>
      </a>

      <ul class="lt-extra" id="lt-cards" hidden></ul>
    </nav>

    <ul class="lt-icons">
      {
        socials.map((l) => (
          <li>
            <a href={l.href} rel="me noopener" target="_blank" aria-label={l.label} title={l.label}>
              <SocialIcon name={l.label} />
            </a>
          </li>
        ))
      }
    </ul>

    <p class="lt-foot">
      <a href="/">{SITE.url.replace('https://', '')} ↗</a>
    </p>
  </div>
</Base>

<script>
  // Custom links live in KV, not in the build, so they're fetched at runtime.
  (() => {
    const wrap = document.getElementById('lt-cards');
    if (!wrap) return;

    const show = (links: Array<{ label?: string; url?: string }>) => {
      if (!Array.isArray(links) || !links.length) return;

      wrap.innerHTML = '';
      for (const link of links) {
        if (!link || !link.url) continue;
        const li = document.createElement('li');
        const a = document.createElement('a');
        a.className = 'lt-link';
        a.href = link.url;
        a.target = '_blank';
        a.rel = 'noopener';

        const label = document.createElement('span');
        label.textContent = link.label || link.url;
        const arrow = document.createElement('em');
        arrow.textContent = '↗';

        a.append(label, arrow);
        li.appendChild(a);
        wrap.appendChild(li);
      }
      wrap.hidden = wrap.children.length === 0;
    };

    fetch('/api/links')
      .then((r) => (r.ok ? r.json() : { links: [] }))
      .then((d) => show(d.links))
      .catch(() => {
        /* offline: the page still works */
      });
  })();
</script>

<style>
  .lt {
    min-height: 100dvh;
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    gap: 0;
    width: min(420px, 100% - 40px);
    margin-inline: auto;
    padding: 56px 0 40px;
    text-align: center;
  }

  /* the sunflower, as a monogram */
  .lt-mark {
    width: 44px;
    height: 44px;
    color: var(--petal);
    margin-bottom: 20px;
  }
  .lt-mark svg { width: 100%; height: 100%; }
  .lt-mark ellipse { fill: currentColor; opacity: .85; }
  .lt-mark circle { fill: var(--bg); stroke: currentColor; stroke-width: 2; }

  .lt h1 {
    font-size: clamp(26px, 7vw, 34px);
    font-weight: 800;
    letter-spacing: -.05em;
    margin: 0;
    color: var(--text);
  }

  .lt-role {
    margin: 6px 0 0;
    font: italic 17px/1.4 var(--serif);
    color: var(--dim);
  }

  .lt-stack {
    width: 100%;
    display: grid;
    gap: 10px;
    margin-top: 34px;
  }

  .lt-extra {
    list-style: none;
    margin: 0;
    padding: 0;
    display: grid;
    gap: 10px;
  }

  /* one shape for every destination */
  .lt-link {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 12px;
    width: 100%;
    padding: 15px 18px;
    border: 1px solid var(--line);
    background: transparent;
    color: var(--text);
    font-family: var(--sans);
    font-size: 13px;
    letter-spacing: .01em;
    text-decoration: none;
    transition:
      border-color .25s ease,
      color .25s ease,
      background .25s ease,
      transform .25s var(--ease);
  }

  .lt-link span {
    font-family: var(--sans);
    font-style: normal;
  }

  .lt-link em {
    font-style: normal;
    font-size: 11px;
    letter-spacing: .06em;
    color: var(--dim);
    transition: color .25s ease, transform .25s var(--ease);
  }

  .lt-link:hover,
  .lt-link:focus-visible {
    border-color: var(--accent);
    color: var(--accent);
    background: color-mix(in srgb, var(--accent) 7%, transparent);
    transform: translateY(-2px);
  }

  .lt-link:hover em { color: var(--accent); transform: translate(2px, -2px); }

  .lt-icons {
    list-style: none;
    display: flex;
    gap: 8px;
    padding: 0;
    margin: 26px 0 0;
  }

  .lt-icons .social-icon { width: 16px; height: 16px; display: block; }

  .lt-icons a {
    display: grid;
    place-items: center;
    width: 40px;
    height: 40px;
    border: 1px solid var(--line);
    border-radius: 50%;
    color: var(--dim);
    font-family: var(--sans);
    font-size: 12px;
    font-weight: 600;
    text-decoration: none;
    transition: color .25s ease, border-color .25s ease, transform .25s var(--ease);
  }

  .lt-icons a:hover,
  .lt-icons a:focus-visible {
    color: var(--accent);
    border-color: var(--accent);
    transform: translateY(-3px);
  }

  .lt-foot {
    margin: 36px 0 0;
    font-size: 11px;
    letter-spacing: .16em;
    text-transform: uppercase;
    font-family: var(--sans);
  }

  .lt-foot a { color: var(--dimmer); text-decoration: none; transition: color .25s ease; }
  .lt-foot a:hover { color: var(--accent); }

  @media (max-width: 420px) {
    .lt { width: 100% - 32px; padding-top: 44px; }
    .lt-link { padding: 14px 16px; }
  }
</style>
