---
import Base from '../layouts/Base.astro';
import Backdrop from '../components/Backdrop.astro';
import { SITE } from '../site.config';

/**
 * Unlisted link-in-bio page. Not linked from anywhere, excluded from the
 * sitemap, noindex. Share the URL directly.
 */
const links = SITE.links;
const email = SITE.links.find((l) => l.label === 'email');
const mailto = email ? email.href.replace(/^mailto:/, '') : SITE.email;
const socials = links.filter((l) => l.label !== 'email');
---

<Base title="links" description={`Everywhere ${SITE.name} is.`} image="/og.png" noindex bare>
  <Backdrop />

  <div class="lt">
    <div class="lt-bar">
      <span class="lt-badge">{SITE.url.replace('https://', '')}</span>
      <a class="lt-hi" href={`mailto:${mailto}`}>say hi ↗</a>
    </div>

    <header class="lt-head">
      <span class="micro">{SITE.jobTitle}</span>
      <h1 class="lt-name">{SITE.name}</h1>
      <p class="lt-bio">Patterns, pixels &amp; the space between.</p>
    </header>

    <a class="lt-mail" href={`mailto:${mailto}`}>
      <span class="micro">email</span>
      <span class="lt-mail-addr">{mailto}</span>
      <span class="lt-mail-arrow" aria-hidden="true">↗</span>
    </a>

    <div class="lt-social">
      {
        socials.map((l) => (
          <a class="pill" href={l.href} rel="me noopener" target="_blank">
            {l.label} ↗
          </a>
        ))
      }
    </div>

    <ul class="lt-cards" id="lt-cards" hidden></ul>

    <p class="lt-foot">
      <a href="/">← {SITE.url.replace('https://', '')}</a>
    </p>
  </div>
</Base>

<script>
  // Custom links live in KV, not in the build, so they're fetched at runtime.
  (() => {
    const wrap = document.getElementById('lt-cards');
    if (!wrap) return;

    fetch('/api/links', { headers: { accept: 'application/json' } })
      .then((r) => (r.ok ? r.json() : Promise.reject(new Error('no links'))))
      .then((d) => {
        const links = Array.isArray(d.links) ? d.links : [];
        if (!links.length) return;

        for (const l of links) {
          const li = document.createElement('li');
          li.className = 'lt-card';

          const a = document.createElement('a');
          a.href = l.url;
          a.target = '_blank';
          a.rel = 'noopener';

          if (l.image) {
            const img = document.createElement('img');
            img.src = l.image;
            img.alt = '';
            img.loading = 'lazy';
            img.referrerPolicy = 'no-referrer';
            img.onerror = () => img.remove();
            a.appendChild(img);
          }

          const body = document.createElement('div');
          body.className = 'lt-card-body';
          const site = document.createElement('span');
          site.className = 'lt-card-site';
          site.textContent = l.site || '';
          const title = document.createElement('strong');
          title.className = 'lt-card-title';
          title.textContent = l.title || l.url;
          const desc = document.createElement('span');
          desc.className = 'lt-card-desc';
          desc.textContent = l.description || '';
          body.append(site, title, desc);

          const arrow = document.createElement('span');
          arrow.className = 'lt-card-arrow';
          arrow.setAttribute('aria-hidden', 'true');
          arrow.textContent = '↗';

          a.append(body, arrow);
          li.appendChild(a);
          wrap.appendChild(li);
        }
        wrap.hidden = false;
      })
      .catch(() => {
        /* no /api/links (astro dev, or no KV) — leave the cards hidden */
      });
  })();
</script>

<style>
  .lt {
    position: relative;
    z-index: 1;
    width: min(620px, calc(100% - 48px));
    margin-inline: auto;
    padding: 44px 0 64px;
  }

  .lt-bar {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 16px;
    padding-bottom: 14px;
    border-bottom: 1px solid var(--line);
    margin-bottom: 40px;
  }

  .lt-badge {
    font-size: 10px;
    letter-spacing: .2em;
    text-transform: uppercase;
    color: var(--dim);
  }

  .lt-hi {
    font-size: 10px;
    letter-spacing: .18em;
    text-transform: uppercase;
    color: var(--text);
    border-bottom: 1px solid var(--line);
    padding-bottom: 2px;
  }
  .lt-hi:hover { border-color: var(--text); }

  .lt-head { margin-bottom: 28px; }
  .lt-head .micro { margin-bottom: 12px; }

  .lt-name {
    margin: 0;
    font-size: clamp(38px, 9vw, 64px);
    font-weight: 800;
    line-height: .92;
    letter-spacing: -.055em;
  }

  .lt-bio {
    font: italic 21px/1.4 var(--serif);
    color: var(--dim);
    margin: 14px 0 0;
  }

  .lt-mail {
    display: flex;
    align-items: center;
    gap: 14px;
    padding: 18px 0;
    border-top: 1px solid var(--line);
    border-bottom: 1px solid var(--line);
    transition: padding-left .25s var(--ease);
  }
  .lt-mail:hover { padding-left: 10px; }

  .lt-mail-addr {
    font-size: 15px;
    color: var(--text);
    overflow-wrap: anywhere;
  }
  .lt-mail-arrow { margin-left: auto; color: var(--dim); }

  .lt-social {
    display: flex;
    flex-wrap: wrap;
    gap: 20px;
    margin-top: 22px;
  }

  .lt-foot { margin: 44px 0 0; font-size: 10px; letter-spacing: .18em; text-transform: uppercase; }
  .lt-foot a { color: var(--dimmer); }
  .lt-foot a:hover { color: var(--text); }

  /* ---- KV-backed cards (built in JS, hence :global) ---- */
  :global(.lt-cards) {
    list-style: none;
    margin: 40px 0 0;
    padding: 0;
    border-top: 1px solid var(--line);
  }
  :global(.lt-card) { border-bottom: 1px solid var(--line); }
  :global(.lt-card a) {
    display: flex;
    align-items: center;
    gap: 16px;
    padding: 18px 0;
    color: var(--text);
    transition: padding-left .25s var(--ease);
  }
  :global(.lt-card a:hover) { padding-left: 12px; }
  :global(.lt-card a:focus-visible) { outline: 1px solid var(--text); outline-offset: 4px; }
  :global(.lt-card img) {
    width: 84px;
    height: 60px;
    object-fit: cover;
    border: 1px solid var(--line);
    background: var(--bg-2);
    flex: 0 0 auto;
    filter: grayscale(1);
    transition: filter .25s ease;
  }
  :global(.lt-card a:hover img) { filter: grayscale(0); }
  :global(.lt-card-body) {
    flex: 1 1 150px;
    min-width: 0;
    display: flex;
    flex-direction: column;
    gap: 4px;
  }
  :global(.lt-card-site) {
    color: var(--dimmer);
    font-size: 10px;
    letter-spacing: .18em;
    text-transform: uppercase;
  }
  :global(.lt-card-title) {
    font-size: 18px;
    font-weight: 600;
    letter-spacing: -.025em;
    line-height: 1.25;
  }
  :global(.lt-card-desc) {
    color: var(--dim);
    font-size: 13px;
    display: -webkit-box;
    -webkit-line-clamp: 2;
    line-clamp: 2;
    -webkit-box-orient: vertical;
    overflow: hidden;
  }
  :global(.lt-card-arrow) { flex: 0 0 auto; color: var(--dim); }
  :global(.lt-card a:hover .lt-card-arrow) { color: var(--text); }

  @media (max-width: 420px) {
    .lt { padding: 28px 0 48px; }
    :global(.lt-card img) { width: 64px; height: 48px; }
  }
</style>
