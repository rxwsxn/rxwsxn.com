---
import { getEntry, render } from 'astro:content';
import Base from '../layouts/Base.astro';

const entry = await getEntry('now', 'now');
const { Content } = entry ? await render(entry) : { Content: null };
---

<Base title="now" description="What I'm focused on right now.">
  <div class="page-head wrap">
    <h1>now</h1>
    <p class="sub">what i'm focused on right now — a nownownow.com page.</p>
  </div>

  <section class="section wrap">
    <div class="prose">
      {entry ? <Content /> : <p class="empty">no /now yet.</p>}
    </div>
  </section>
</Base>
