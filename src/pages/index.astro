---
import { getCollection } from 'astro:content';
import Base from '../layouts/Base.astro';
import Hero from '../components/Hero.astro';

const posts = (await getCollection('blog', ({ data }) => !data.draft))
  .sort((a, b) => b.data.date.valueOf() - a.data.date.valueOf())
  .slice(0, 3);

const hub = [
  { href: '/blog', title: 'blog', desc: 'dated notes — mostly ai, product, and building.' },
  { href: '/about', title: 'about', desc: 'who i am, and how i work.' },
  { href: '/contact', title: 'contact', desc: 'email, github, and the fastest way to reach me.' },
];
---

<Base>
  <Hero />

  <section class="section wrap">
    <div class="sec-head">
      <span class="sec-num">01</span>
      <span class="label">explore</span>
    </div>
    <div class="hub">
      {
        hub.map((h) => (
          <a class="hub-card glass" href={h.href}>
            <span class="hub-title">{h.title}</span>
            <span class="hub-desc">{h.desc}</span>
          </a>
        ))
      }
    </div>
  </section>

  <section class="section wrap">
    <div class="sec-head">
      <span class="sec-num">02</span>
      <span class="label">latest writing</span>
    </div>
    {
      posts.length > 0 ? (
        <ul class="list">
          {posts.map((post) => (
            <li>
              <div class="post-meta">
                <a class="post-title" href={`/blog/${post.id}/`}>
                  {post.data.title}
                </a>
                <span class="post-date">{post.data.date.toISOString().slice(0, 10)}</span>
              </div>
              {post.data.summary && <p class="post-excerpt">{post.data.summary}</p>}
            </li>
          ))}
        </ul>
      ) : (
        <p class="empty">no posts yet.</p>
      )
    }
    <p class="small"><a href="/blog">all posts →</a></p>
  </section>
</Base>
