---
import { getCollection } from 'astro:content';
import Base from '../layouts/Base.astro';
import Hero from '../components/Hero.astro';

const posts = (await getCollection('blog', ({ data }) => !data.draft))
  .sort((a, b) => b.data.date.valueOf() - a.data.date.valueOf())
  .slice(0, 3);

const work = (await getCollection('work'))
  .sort((a, b) => a.data.order - b.data.order)
  .slice(0, 4);

const caps = [
  {
    title: 'Product engineering',
    body: 'Models out of notebooks and into products: retrieval, agents, copilots, and the multi-tenant plumbing under them.',
  },
  {
    title: 'Evaluation',
    body: 'Evals that catch a regression before a user does, with datasets and feedback loops that stay honest.',
  },
  {
    title: 'Interfaces',
    body: 'The surface where the model meets a person — streaming, latency, failure states, and copy that explains itself.',
  },
];

const pad = (n: number) => String(n).padStart(2, '0');
---

<Base>
  <Hero />

  <section class="section wrap" id="work">
    <div class="sec-head">
      <span class="count">(01)</span>
      <h2>Work</h2>
      <p class="serif">Selected builds, mostly in production.</p>
    </div>

    {
      work.length > 0 ? (
        <ul class="list">
          {work.map((item, i) => (
            <li class="reveal">
              <span class="idx">{pad(i + 1)}</span>
              <div class="row-main">
                <a class="work-title" href="/work">
                  {item.data.title}
                </a>
                <p class="work-summary">{item.data.summary}</p>
                <div class="work-meta">
                  {item.data.org && <span>{item.data.org}</span>}
                  {item.data.stack.length > 0 && <span>{item.data.stack.join(' · ')}</span>}
                </div>
              </div>
              <span class="post-date">{item.data.period}</span>
            </li>
          ))}
        </ul>
      ) : (
        <p class="empty">Nothing here yet.</p>
      )
    }
  </section>

  <section class="section wrap">
    <div class="sec-head">
      <span class="count">(02)</span>
      <h2>Capabilities</h2>
      <p class="serif">What I'm actually hired for.</p>
    </div>

    <ul class="list">
      {
        caps.map((c, i) => (
          <li class="reveal">
            <span class="idx">{pad(i + 1)}</span>
            <div class="row-main">
              <span class="work-title">{c.title}</span>
              <p class="work-summary">{c.body}</p>
            </div>
          </li>
        ))
      }
    </ul>
  </section>

  <section class="section wrap" id="writing">
    <div class="sec-head">
      <span class="count">(03)</span>
      <h2>Writing</h2>
      <p class="serif">Notes from the margins.</p>
    </div>

    {
      posts.length > 0 ? (
        <ul class="list">
          {posts.map((post, i) => (
            <li class="reveal">
              <span class="idx">{pad(i + 1)}</span>
              <div class="row-main">
                <a class="post-title" href={`/blog/${post.id}/`}>
                  {post.data.title}
                </a>
                {post.data.summary && <p class="post-excerpt">{post.data.summary}</p>}
              </div>
              <span class="post-date">{post.data.date.toISOString().slice(0, 10)}</span>
            </li>
          ))}
        </ul>
      ) : (
        <p class="empty">No posts yet — the first one is on its way.</p>
      )
    }
  </section>
</Base>
