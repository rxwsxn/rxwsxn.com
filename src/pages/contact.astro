---
import Base from '../layouts/Base.astro';
import CopyEmail from '../components/CopyEmail.astro';
import SocialIcon from '../components/SocialIcon.astro';
import { SITE } from '../site.config';

// every http(s) entry in SITE.links becomes a logo link
const socials = SITE.links.filter((l) => l.href.startsWith('http'));
---

<Base
  title="contact"
  description={`Get in touch with ${SITE.name}.`}
  image="/og/contact.png"
>
  <div class="page-head wrap">
    <h1>contact</h1>
    <p class="sub">the fastest way to reach me is email.</p>
  </div>

  <section class="section wrap">
    <div class="email-row">
      <SocialIcon name="mail" />
      <CopyEmail />
    </div>

    <ul class="socials">
      {socials.map((l) => (
        <li>
          <a href={l.href} rel="me noopener" aria-label={l.label} title={l.label}>
            <SocialIcon name={l.label} />
          </a>
        </li>
      ))}
    </ul>
  </section>
</Base>
