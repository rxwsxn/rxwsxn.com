---
import Base from '../layouts/Base.astro';
import CopyEmail from '../components/CopyEmail.astro';
import { SITE } from '../site.config';

const extra = SITE.links.filter(
  (l) => l.label !== 'github' && l.label !== 'email',
);
---

<Base title="contact" description={`Get in touch with ${SITE.name}.`}>
  <div class="page-head wrap">
    <h1>contact</h1>
    <p class="sub">the fastest way to reach me is email.</p>
  </div>

  <section class="section wrap">
    <ul class="contact-list">
      <li>
        <span class="contact-key">email</span>
        <CopyEmail />
      </li>
      <li>
        <span class="contact-key">github</span>
        <span class="contact-val">
          <a href={SITE.github}>{SITE.github.replace('https://', '')}</a>
        </span>
      </li>
      {extra.map((l) => (
        <li>
          <span class="contact-key">{l.label}</span>
          <span class="contact-val"><a href={l.href}>{l.href}</a></span>
        </li>
      ))}
    </ul>

    <p class="muted small">
      linkedin / x / resume — add them in <code>src/site.config.ts</code> and they
      show up here.
    </p>
  </section>
</Base>
